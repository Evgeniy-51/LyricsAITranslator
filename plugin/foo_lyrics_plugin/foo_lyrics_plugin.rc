#include "resource.h"
#include <winres.h>

IDD_LYRICS_WINDOW DIALOGEX 0, 0, 480, 420
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Lyrics"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_LYRICS_LIST, 10, 10, 460, 330, LBS_OWNERDRAWVARIABLE | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Get all lyrics", IDC_BTN_GET_ALL, 10, 350, 105, 32
    PUSHBUTTON      "Cancel", IDC_BTN_CANCEL_BATCH, 121, 350, 105, 32, WS_DISABLED
    PUSHBUTTON      "Sync cache", IDC_BTN_SYNC_CACHE, 232, 350, 105, 32
    PUSHBUTTON      "Reload track", IDC_BTN_REFRESH_TRACK, 343, 350, 105, 32
    LTEXT           "Ready", IDC_STATIC_STATUS, 10, 388, 460, 20, SS_NOTIFY
END

IDD_WEB_QR DIALOGEX 0, 0, 240, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lyrics Web"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Scan with your phone:", IDC_STATIC, 12, 10, 216, 10
    LTEXT           "", IDC_QR_URL_TEXT, 12, 24, 216, 24
    CONTROL         "", IDC_QR_IMAGE, "Static", SS_BLACKRECT | WS_GROUP, 20, 54, 200, 200
    DEFPUSHBUTTON   "Close", IDOK, 92, 262, 56, 14
END

IDD_CUSTOM_LANG DIALOGEX 0, 0, 280, 72
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Target language"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Language name (sent to the translator as-is):", IDC_STATIC_CUSTOM_LANG_HINT, 7, 7, 266, 8
    EDITTEXT        IDC_EDIT_CUSTOM_LANG, 7, 20, 266, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 170, 48, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 48, 50, 14
END

IDD_PREFERENCES DIALOGEX 0, 0, 286, 128
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Enable translation", IDC_PREF_ENABLE_TRANSLATION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 8, 272, 10
    LTEXT           "Target language", IDC_PREF_LBL_LANG, 7, 26, 272, 8
    COMBOBOX        IDC_PREF_TARGET_LANG, 7, 38, 272, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Target language for AI translation of lyrics.", IDC_PREF_NOTE_LANG, 7, 72, 272, 18
    PUSHBUTTON      "Open plugin folder", IDC_PREF_OPEN_CONFIG_DIR, 7, 100, 110, 14
END

IDD_PREFERENCES_LLM DIALOGEX 0, 0, 286, 176
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Base URL", IDC_PREF_LBL_LLM_BASE, 7, 8, 272, 8
    EDITTEXT        IDC_PREF_LLM_BASE, 7, 20, 272, 14, ES_AUTOHSCROLL
    LTEXT           "Model", IDC_PREF_LBL_LLM_MODEL, 7, 42, 272, 8
    EDITTEXT        IDC_PREF_LLM_MODEL, 7, 54, 272, 14, ES_AUTOHSCROLL
    LTEXT           "API key", IDC_PREF_LBL_LLM_KEY, 7, 76, 272, 8
    EDITTEXT        IDC_PREF_LLM_KEY, 7, 88, 272, 14, ES_AUTOHSCROLL
    LTEXT           "OpenAI-compatible API used to fetch and translate lyrics.", IDC_PREF_NOTE_LLM, 7, 112, 272, 18
    PUSHBUTTON      "Open plugin folder", IDC_PREF_OPEN_CONFIG_DIR_LLM, 7, 148, 110, 14
END

IDD_PREFERENCES_PROXY DIALOGEX 0, 0, 286, 220
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Enable proxy", IDC_PREF_PROXY_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 8, 272, 10
    LTEXT           "Type", IDC_PREF_LBL_PROXY_TYPE, 7, 26, 36, 8
    CONTROL         "SOCKS5", IDC_PREF_PROXY_TYPE_SOCKS5, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 48, 24, 55, 10
    CONTROL         "HTTP", IDC_PREF_PROXY_TYPE_HTTP, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 110, 24, 50, 10
    LTEXT           "Host", IDC_PREF_LBL_PROXY_URL, 7, 42, 272, 8
    EDITTEXT        IDC_PREF_PROXY_URL, 7, 54, 272, 14, ES_AUTOHSCROLL
    LTEXT           "Port", IDC_PREF_LBL_PROXY_PORT, 7, 76, 272, 8
    EDITTEXT        IDC_PREF_PROXY_PORT, 7, 88, 272, 14, ES_AUTOHSCROLL
    LTEXT           "User", IDC_PREF_LBL_PROXY_USER, 7, 110, 272, 8
    EDITTEXT        IDC_PREF_PROXY_USER, 7, 122, 272, 14, ES_AUTOHSCROLL
    LTEXT           "Password", IDC_PREF_LBL_PROXY_PASS, 7, 144, 272, 8
    EDITTEXT        IDC_PREF_PROXY_PASS, 7, 156, 272, 14, ES_AUTOHSCROLL
    LTEXT           "SOCKS5 or HTTP CONNECT for LRCLib and LLM. On by default; off = direct. SOCKS4 not supported.", IDC_PREF_NOTE_PROXY, 7, 176, 272, 18
    PUSHBUTTON      "Open plugin folder", IDC_PREF_OPEN_CONFIG_DIR_PROXY, 7, 198, 110, 14
END

IDD_PREFERENCES_CACHE DIALOGEX 0, 0, 286, 236
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Cache folder", IDC_PREF_LBL_CACHE_DIR, 7, 6, 272, 8
    EDITTEXT        IDC_PREF_CACHE_DIR, 7, 16, 220, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_PREF_CACHE_BROWSE, 232, 15, 47, 14

    CONTROL         "", IDC_PREF_CACHE_SEP, "Static", SS_ETCHEDHORZ, 7, 40, 272, 1

    LTEXT           "Remote sync (optional)", IDC_PREF_NOTE_CACHE_REMOTE, 7, 45, 272, 8
    CONTROL         "Enable Git sync", IDC_PREF_SYNC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 57, 272, 10
    LTEXT           "Remote URL", IDC_PREF_LBL_SYNC_REMOTE, 7, 71, 272, 8
    EDITTEXT        IDC_PREF_SYNC_REMOTE, 7, 81, 272, 14, ES_AUTOHSCROLL
    LTEXT           "PAT (GitHub/GitLab token)", IDC_PREF_LBL_SYNC_PAT, 7, 99, 272, 8
    EDITTEXT        IDC_PREF_SYNC_PAT, 7, 109, 272, 14, ES_AUTOHSCROLL
    LTEXT           "Branch", IDC_PREF_LBL_SYNC_BRANCH, 7, 127, 272, 8
    EDITTEXT        IDC_PREF_SYNC_BRANCH, 7, 137, 272, 14, ES_AUTOHSCROLL
    CONTROL         "Pull on startup", IDC_PREF_SYNC_PULL_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 157, 110, 10
    CONTROL         "Auto setup", IDC_PREF_SYNC_AUTO_SETUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 157, 80, 10

    LTEXT           "Default cache: temp next to the plugin. Changing folder does not move files. Git sync is optional.", IDC_PREF_NOTE_CACHE, 7, 174, 272, 22
    PUSHBUTTON      "Open plugin folder", IDC_PREF_OPEN_CONFIG_DIR_CACHE, 7, 200, 110, 14
END

IDD_PREFERENCES_WEB DIALOGEX 0, 0, 286, 176
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Enable web remote control", IDC_PREF_WEB_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 8, 272, 10
    LTEXT           "Port", IDC_PREF_LBL_WEB_PORT, 7, 26, 272, 8
    EDITTEXT        IDC_PREF_WEB_PORT, 7, 38, 272, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Auth token (optional)", IDC_PREF_LBL_WEB_TOKEN, 7, 60, 272, 8
    EDITTEXT        IDC_PREF_WEB_TOKEN, 7, 72, 272, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Generate token", IDC_PREF_GEN_WEB_TOKEN, 7, 92, 90, 14
    LTEXT           "Leave empty: anyone on your Wi-Fi can open the page. With token: only devices with the URL that includes the token. Works while the lyrics window is open.", IDC_PREF_NOTE_WEB, 7, 114, 272, 28
    PUSHBUTTON      "Open plugin folder", IDC_PREF_OPEN_CONFIG_DIR_WEB, 7, 150, 110, 14
END
